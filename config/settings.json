{
  "habit": "study",
  "pomodoro": {
    "templates": [
      {
        "name": null,
        "work_minutes": 25.0,
        "break_minutes": 5,
        "rounds": 4
      },
      {
        "name": null,
        "work_minutes": 25.0,
        "break_minutes": 5,
        "rounds": 2
      }
    ],
    "active_template": 0,
    "resume_window_minutes": 10
  },
  "time": {
    "timezone": "Europe/Berlin",
    "rollover_hour": 3
  },
  "evidence": {
    "auto_commit": true,
    "auto_push": true,
    "remote": "origin",
    "branch": "main",
    "commit_message_template": "event: {type} [{origin}] @ {iso}",
    "warn_when_unpushed": true
  },
  "ui": {
    "theme": "dark",
    "notifications": true,
    "sound": "notification",
    "always_on_top": false,
    "break_reminder_minutes": 5
  },
  "goals": {
    "low_minutes": 50,
    "low_buffer_minutes": 5,
    "middle_minutes": 100,
    "middle_buffer_minutes": 10,
    "high_minutes": 200,
    "high_buffer_minutes": 15
  },
  "extras": {
    "enabled": true,
    "wakeup": {
      "habit": "sleep",
      "default_wake_time": "06:00:00",
      "default_bedtime": "20:30:00"
    },
    "workout": {
      "habit": "workout"
    }
  },
  "paths": {
    "data_repo": "../habito-data"
  }
}

{
  "habit": "study",
  "pomodoro": {
    "work_minutes": 25.0,
    "break_minutes": 5,
    "rounds": 4,
    "resume_window_minutes": 30
  },
  "time": {
    "timezone": "Europe/Berlin",
    "rollover_hour": 3
  },
  "evidence": {
    "auto_commit": true,
    "auto_push": true,
    "remote": "origin",
    "branch": "main",
    "commit_message_template": "event: {type} [{origin}] @ {iso}",
    "warn_when_unpushed": true
  },
  "ui": {
    "theme": "dark",
    "notifications": true,
    "sound": "notification",
    "always_on_top": false,
    "break_reminder_minutes": 3
  },
  "goals": {
    "daily_minutes": 100,
    "buffer_minutes": 5,
    "stretch_minutes": 200,
    "stretch_buffer_minutes": 10
  },
  "paths": {
    "data_repo": "../habito-data"
  }
}
